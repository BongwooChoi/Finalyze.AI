OPEN_DART_API_KEY=
OPENAI_API_KEY=
# Shared AI analysis attempt caps (both routes; KST day). Zero disables AI.
AI_MEMBER_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=200
# Google Identity Services web client. Production origin must be authorized.
GOOGLE_CLIENT_ID=
# Comma-separated verified Google email allowlist; requires a new Google login to grant admin access.
ADMIN_EMAILS=
APP_ORIGIN=http://localhost:3000
# Independent random secrets, at least 32 characters each. Preserve USER_ID_SECRET.
SESSION_SECRET=
USER_ID_SECRET=
# Exactly 32 random bytes encoded as base64. Preserve this key to read stored subscriptions.
USER_DATA_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
# Neon Postgres; omitted only for local SQLite in .data/accounts.sqlite.
DATABASE_URL=
# Shared DART response cache and rate limit (required on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: gmail or resend. Without a choice, a configured Resend sender takes priority.
MAIL_PROVIDER=
# Free Gmail sender: enable 2-Step Verification and use a dedicated 16-character app password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Resend sender: leave both unset until a sender domain has been verified.
RESEND_API_KEY=
MAIL_FROM=
# Channel broadcast remains off until the bot and channel permissions are verified.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
