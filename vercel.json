{
  "version": 2,
  "schedules": {
    "disclosure-alerts": {
      "schedule": "*/15 * * * *",
      "timezone": "Asia/Seoul",
      "jitter": 15,
      "path": "/api/jobs/disclosures",
      "requestMethod": "POST"
    }
  },
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
