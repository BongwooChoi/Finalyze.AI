OPEN_DART_API_KEY=
OPENAI_API_KEY=
# Google Identity Services web client. Production origin must be authorized.
GOOGLE_CLIENT_ID=
APP_ORIGIN=http://localhost:3000
# Independent random secrets, at least 32 characters each. Preserve USER_ID_SECRET.
SESSION_SECRET=
USER_ID_SECRET=
# Exactly 32 random bytes encoded as base64. Preserve this key to read stored subscriptions.
USER_DATA_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
# Neon Postgres; omitted only for local SQLite in .data/accounts.sqlite.
DATABASE_URL=
# Shared DART response cache and rate limit (required on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Leave both unset until a sender domain has been verified.
RESEND_API_KEY=
MAIL_FROM=
# Channel broadcast remains off until the bot and channel permissions are verified.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
